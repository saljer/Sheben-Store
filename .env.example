# Секреты Sheben'Store. Скопируйте этот файл в .env и впишите свои значения.
# Файл .env в git не попадает. Пустое значение — функция выключена.

# Ключ Google AI Studio (aistudio.google.com -> Get API key): проверка фото через Gemini
GEMINI_API_KEY=

# Токен бота от @BotFather: уведомления в Telegram. После этого напишите боту /start
TG_BOT_TOKEN=

# Заполняется само, когда вы напишете боту /start
TG_CHAT_ID=

# Заполняется само, когда вы включаете доступ с телефона
PHONE_TOKEN=
